@page "/usage-count"
@using ZentitleSaaSDemo.Zentitle
@attribute [Authorize]

<PageTitle>ElevateSaaS : Usage Count</PageTitle>

@inject ZentitleService Service

<h4>Usage Count</h4>

@if (_usageCount != null)
{
    <div class="card mb-3 mt-4" style="width: 18rem;">
        <div class="card-body">
            <strong>Available:</strong> @_usageCount.Available
        </div>
    </div>
    if (_usageCount.Available > 0)
    {
        <button class="btn btn-primary" disabled="@_loading" @onclick="Add">Checkout</button>
    }
}

@code {
    private ActivationFeatureModel? _usageCount;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _usageCount = Service.GetUsageCount();
        await base.OnInitializedAsync();
    }

    private async void Add()
    {
        _loading = true;
        try
        {
            _usageCount = await Service.CheckoutUsageCount();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void LoadData()
    {
        _usageCount = Service.GetUsageCount();
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Service.OnChange += LoadData;
    }

    public void Dispose()
    {
        Service.OnChange -= LoadData;
    }

}